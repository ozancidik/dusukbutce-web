meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

docs {
  Public. Başarılıysa httpOnly cookie (auth-token) set eder ve kullanıcı
  bilgisini döner. email/password ortam değişkeni olarak ayarlanmalı
  (gerçek değerleri .bru dosyasına yazma — environments/local.bru'ya
  eklenip git'e commit edilmemeli, bkz. .gitignore).
}
