# Bu dosya şablondur — GERÇEK değerleri buraya YAZMAYIN.
# Kopyalayıp `.env.local` oluşturun ve değerleri orada doldurun (.env.local git'e girmez).

# --- Veritabanı ---
MONGODB_URI=mongodb+srv://<kullanici>:<sifre>@<cluster>.mongodb.net/<db>

# --- Kimlik doğrulama ---
JWT_SECRET=<uzun-rastgele-gizli-anahtar>

# --- E-posta (Gmail) ---
GMAIL_USER=ornek@gmail.com
GMAIL_APP_PASSWORD=<gmail-uygulama-sifresi>

# --- OAuth: Google ---
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>

# --- OAuth: Facebook ---
FACEBOOK_APP_ID=<facebook-app-id>
FACEBOOK_APP_SECRET=<facebook-app-secret>

# --- Genel ---
NEXT_PUBLIC_SITE_URL=https://dusukbutce.com
# İzin verilen CORS origin'leri (virgülle ayrılmış), opsiyonel
# ALLOWED_ORIGINS=https://dusukbutce.com,https://www.dusukbutce.com
