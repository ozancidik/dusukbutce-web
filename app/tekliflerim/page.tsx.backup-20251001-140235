                color: '#0284c7',
                fontWeight: '500'
              }}>
                Toplam Talep
              </div>
            </div>
            
            <div style={{
              background: 'linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%)',
              padding: isMobile ? '12px 16px' : '16px 24px',
              borderRadius: '12px',
              border: '1px solid #bbf7d0'
            }}>
              <div style={{
                fontSize: isMobile ? '20px' : '24px',
                fontWeight: '700',
                color: '#166534'
              }}>
                {submissions.filter(s => s.status === 'offered').length}
              </div>
