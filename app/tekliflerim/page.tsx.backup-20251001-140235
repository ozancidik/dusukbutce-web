              e.currentTarget.style.boxShadow = '0 4px 12px rgba(37, 99, 235, 0.3)';
            }}
          >
            Satış Talebi Oluştur
          </button>
        </div>
      ) : (
        <div style={{
          display: 'grid',
          gap: isMobile ? '16px' : '24px'
