        </div>

        {/* Tab Content */}
        <div style={{
          minHeight: '400px',
          marginBottom: '24px'
        }}>
          {activeTab === 'temel' && (
            <div style={{
              display: 'grid',
              gridTemplateColumns: isMobile ? '1fr' : 'repeat(2, 1fr)',
              gap: '16px'
            }}>
              {renderField('Marka', submission.brand, true)}
              {renderField('Model', submission.model, true)}
              {renderField('Kategori', getCategoryDisplayName(submission.category), true)}
              {renderField('Adet', submission.quantity)}
              {renderField('Kozmetik Durum', submission.cosmeticCondition)}
              {renderField('Açıklama', submission.description)}
            </div>
          )}

          {activeTab === 'teknik' && (
            <div style={{
              display: 'grid',
              gridTemplateColumns: isMobile ? '1fr' : 'repeat(2, 1fr)',
              gap: '16px'
            }}>
              {/* Notebook/Desktop alanları */}
              {renderField('İşlemci', submission.processor)}
              {renderField('İşlemci Markası', submission.processorBrand)}
              {renderField('Ekran Kartı', submission.graphicsCard)}
              {renderField('Ekran Kartı Watt', submission.graphicsCardWatt)}
              {renderField('RAM', submission.ram)}
              {renderField('RAM Tipi', submission.ramType)}
              {renderField('Depolama', submission.storage)}
              {renderField('Depolama Tipi', submission.storageType)}
              {renderField('Ekran Boyutu', submission.screenSize)}
              {renderField('Yenileme Hızı', submission.refreshRate)}
              {renderField('Pil Durumu', submission.batteryHealth)}
              
              {/* Ekran Kartı alanları */}
              {renderField('Chip Set', submission.chipSet)}
              {renderField('Bellek', submission.memory)}
              {renderField('Bellek Tipi', submission.memoryType)}
              {renderField('Portlar', submission.ports)}
              {renderField('DVI Çıkışı', submission.dviOutput)}
              {renderField('Furmark Sonucu', submission.furmarkResult)}
              {renderField('Açıldı mı?', submission.opened)}
