                      {renderField('E-posta', (submission as any).customerInfo.email, true)}
                      {renderField('Telefon', (submission as any).customerInfo.phone, true)}
                      {renderField('Şehir', (submission as any).customerInfo.city, true)}
                      {renderField('İlçe', (submission as any).customerInfo.district, true)}
                      {renderField('Detaylı Adres', (submission as any).customerInfo.address, true)}
                      {renderField('Ek Notlar', (submission as any).customerInfo.notes)}
                    </div>
                  </div>
                </>
              ) : (
                /* Teslimat Bilgileri Bekleniyor */
                <div style={{
                  gridColumn: isMobile ? '1' : '1 / -1',
                  background: 'linear-gradient(135deg, #fef3c7 0%, #fde68a 100%)',
                  padding: '40px 20px',
                  borderRadius: '12px',
                  border: '2px solid #f59e0b',
                  textAlign: 'center'
                }}>
                  <div style={{
                    background: '#f59e0b',
                    borderRadius: '50%',
                    width: '60px',
                    height: '60px',
                    display: 'flex',
                    alignItems: 'center',
                    justifyContent: 'center',
                    fontSize: '30px',
                    margin: '0 auto 20px'
                  }}>
                    ⏳
                  </div>
                  <h4 style={{
                    fontSize: isMobile ? '18px' : '20px',
                    fontWeight: '700',
                    color: '#92400e',
                    margin: '0 0 8px 0'
                  }}>
                    Teslimat Bilgileri Bekleniyor
                  </h4>
                  <p style={{
                    fontSize: isMobile ? '14px' : '16px',
                    color: '#92400e',
                    margin: 0,
                    lineHeight: '1.5'
                  }}>
                    Müşteri henüz teslimat bilgilerini göndermedi. Müşteri teklifi kabul ettikten sonra teslimat bilgilerini dolduracak.
                  </p>
                </div>
              )}
            </div>
          )}
        </div>

        {/* Durum Bilgileri */}
        <div style={{
          background: '#f8fafc',
          padding: '20px',
          borderRadius: '12px',
          border: '1px solid #e2e8f0',
          marginBottom: '24px'
        }}>
          <h3 style={{
            fontSize: isMobile ? '16px' : '18px',
            fontWeight: '600',
            color: '#374151',
            margin: '0 0 16px 0',
            paddingBottom: '8px',
            borderBottom: '2px solid #e5e7eb'
          }}>
            📦 Durum Bilgileri
          </h3>
          
          <div style={{
            display: 'grid',
            gridTemplateColumns: isMobile ? '1fr' : 'repeat(2, 1fr)',
            gap: '16px'
          }}>
            {renderBooleanField('Kutu', submission.hasBox || false)}
            {renderBooleanField('Fatura', submission.hasInvoice || false)}
            {renderBooleanField('Garanti', submission.hasWarranty || false)}
            {renderField('Garanti Süresi', submission.warrantyDuration)}
            {renderField('Fatura Tarihi', submission.invoiceDate)}
            {renderField('Ekran Durumu', submission.screenStatus)}
            {renderField('Ölü Piksel Sayısı', submission.deadPixelCount)}
          </div>
        </div>

        {/* Fotoğraflar */}
        {renderImages()}

        {/* Admin Notları */}
        {submission.adminNotes && (
          <div style={{
            background: submission.adminNotes.includes('YENİDEN TEKLİF TALEBİ:') ? '#dbeafe' : 
                       submission.adminNotes.includes('REDDEDİLDİ:') ? '#fef2f2' : '#fef3c7',
            padding: '16px',
            borderRadius: '8px',
            border: submission.adminNotes.includes('YENİDEN TEKLİF TALEBİ:') ? '1px solid #3b82f6' : 
                   submission.adminNotes.includes('REDDEDİLDİ:') ? '1px solid #fca5a5' : '1px solid #fcd34d',
            marginBottom: '16px'
          }}>
            <h4 style={{
              fontSize: isMobile ? '14px' : '16px',
              fontWeight: '600',
              color: submission.adminNotes.includes('YENİDEN TEKLİF TALEBİ:') ? '#1e40af' : 
                    submission.adminNotes.includes('REDDEDİLDİ:') ? '#dc2626' : '#92400e',
              margin: '0 0 8px 0',
              display: 'flex',
              alignItems: 'center',
              gap: '8px'
            }}>
              {submission.adminNotes.includes('YENİDEN TEKLİF TALEBİ:') ? (
                <>
                  🔄 Yeniden Teklif Talebi
                </>
              ) : submission.adminNotes.includes('REDDEDİLDİ:') ? (
                <>
                  ❌ Reddetme Sebebi
                </>
              ) : (
                '📝 Admin Notları:'
              )}
            </h4>
            <p style={{
              fontSize: isMobile ? '14px' : '16px',
              color: submission.adminNotes.includes('YENİDEN TEKLİF TALEBİ:') ? '#1e40af' : 
                    submission.adminNotes.includes('REDDEDİLDİ:') ? '#dc2626' : '#92400e',
              margin: 0,
              lineHeight: '1.5'
            }}>
              {submission.adminNotes.includes('YENİDEN TEKLİF TALEBİ:') 
                ? submission.adminNotes.replace('YENİDEN TEKLİF TALEBİ: ', '')
                : submission.adminNotes.includes('REDDEDİLDİ:')
                ? submission.adminNotes.replace('REDDEDİLDİ: ', '')
                : submission.adminNotes
              }
            </p>
          </div>
        )}

        {/* Yeniden Teklif Talebi */}
        {submission.adminNotes && submission.adminNotes.includes('YENİDEN TEKLİF TALEBİ:') && (
          <div style={{
            background: 'linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%)',
            padding: '20px',
            borderRadius: '12px',
            border: '2px solid #3b82f6',
            marginBottom: '20px',
            boxShadow: '0 4px 12px rgba(59, 130, 246, 0.15)'
          }}>
            <div style={{
              display: 'flex',
              alignItems: 'center',
              gap: '12px',
              marginBottom: '12px'
            }}>
              <div style={{
                background: '#3b82f6',
                borderRadius: '50%',
                width: '40px',
                height: '40px',
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center',
                fontSize: '20px'
              }}>
                🔄
              </div>
              <div>
                <h4 style={{
                  fontSize: isMobile ? '16px' : '18px',
                  fontWeight: '700',
                  color: '#1e40af',
                  margin: '0 0 4px 0'
                }}>
                  Yeniden Teklif Talebi
                </h4>
                <p style={{
                  fontSize: isMobile ? '12px' : '14px',
                  color: '#1e40af',
                  margin: 0,
                  opacity: 0.8
                }}>
                  Müşteri bu ürün için yeniden teklif talebinde bulundu
                </p>
              </div>
            </div>
            <div style={{
              background: 'rgba(255, 255, 255, 0.7)',
              padding: '16px',
              borderRadius: '8px',
              border: '1px solid rgba(59, 130, 246, 0.3)'
            }}>
              <p style={{
                fontSize: isMobile ? '14px' : '16px',
                color: '#1e40af',
                margin: 0,
                lineHeight: '1.6',
                fontStyle: 'italic'
              }}>
                "{submission.adminNotes.replace('YENİDEN TEKLİF TALEBİ: ', '')}"
              </p>
            </div>
          </div>
        )}

        {/* Talep Bilgileri */}
        <div style={{
          background: '#f0f9ff',
          padding: '16px',
          borderRadius: '8px',
          border: '1px solid #bae6fd',
          marginBottom: '16px'
        }}>
          <h4 style={{
            fontSize: isMobile ? '14px' : '16px',
            fontWeight: '600',
            color: '#0369a1',
            margin: '0 0 8px 0'
          }}>
            📅 Talep Bilgileri
          </h4>
          <div style={{
            display: 'grid',
            gridTemplateColumns: isMobile ? '1fr' : 'repeat(2, 1fr)',
            gap: '12px'
          }}>
            <div>
              <span style={{ fontSize: isMobile ? '12px' : '14px', color: '#0369a1', fontWeight: '600' }}>
                Talep Tarihi:
              </span>
              <div style={{ fontSize: isMobile ? '14px' : '16px', color: '#0369a1' }}>
                {formatDate(submission.createdAt)}
              </div>
            </div>
            <div>
              <span style={{ fontSize: isMobile ? '12px' : '14px', color: '#0369a1', fontWeight: '600' }}>
                Durum:
              </span>
              <div style={{ fontSize: isMobile ? '14px' : '16px', color: '#0369a1' }}>
                {submission.status === 'pending' ? 'Beklemede' :
                 submission.status === 'offered' ? 'Teklif Verildi' :
                 submission.status === 'listed' ? 'İlan Oluşturuldu' :
                 submission.status === 'rejected' ? 'Reddedildi' :
                 submission.status === 'accepted' ? 'Kabul Edildi' :
                 submission.status === 'customer_rejected' ? 'Müşteri Reddetti' :
                 submission.status}
              </div>
            </div>
          </div>
        </div>

        {/* Close Button */}
        <div style={{
          display: 'flex',
          justifyContent: 'center',
          marginTop: '24px'
        }}>
          <button
            onClick={onClose}
            style={{
              background: 'linear-gradient(135deg, #3b82f6 0%, #2563eb 100%)',
              color: 'white',
              border: 'none',
              borderRadius: '12px',
              padding: isMobile ? '14px 24px' : '16px 32px',
              fontSize: isMobile ? '14px' : '16px',
              fontWeight: '600',
              cursor: 'pointer',
              transition: 'all 0.2s',
              boxShadow: '0 4px 12px rgba(59, 130, 246, 0.3)',
              minWidth: '120px'
            }}
            onMouseEnter={(e) => {
              e.currentTarget.style.transform = 'translateY(-2px)';
              e.currentTarget.style.boxShadow = '0 6px 20px rgba(59, 130, 246, 0.4)';
            }}
            onMouseLeave={(e) => {
              e.currentTarget.style.transform = 'translateY(0)';
              e.currentTarget.style.boxShadow = '0 4px 12px rgba(59, 130, 246, 0.3)';
            }}
          >
            Kapat
          </button>
        </div>
      </div>
    </div>
    </>
  );
}
