            fontSize: isMobile ? '20px' : '24px',
            color: '#dc2626',
            margin: '0 0 16px 0'
          }}>
            Veri Yüklenirken Hata Oluştu
          </h2>
          <p style={{
            fontSize: '16px',
            color: '#6b7280',
            margin: '0 0 24px 0',
            lineHeight: '1.5'
          }}>
            {error}
          </p>
